{
  "name": "buildql",
  "version": "0.1.0",
  "description": "Type-safe GraphQL query builder generated from introspection",
  "license": "MIT",
  "type": "module",
  "keywords": ["graphql", "typescript", "codegen", "query-builder", "type-safe"],
  "repository": { "type": "git", "url": "git+https://github.com/rozimek/buildql.git" },
  "sideEffects": false,
  "bin": { "buildql": "./dist/cli/index.js" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./client": { "types": "./dist/client/client.d.ts", "import": "./dist/client/client.js", "require": "./dist/client/client.cjs" },
    "./config": { "types": "./dist/cli/config.d.ts", "import": "./dist/cli/config.js", "require": "./dist/cli/config.cjs" }
  },
  "typesVersions": {
    "*": {
      "client": ["./dist/client/client.d.ts"],
      "config": ["./dist/cli/config.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.typetest.json",
    "test:perf": "node scripts/typeperf.mjs",
    "check": "npm run test:types && npm run test && npm run test:perf"
  },
  "peerDependencies": {
    "typescript": ">=5.4",
    "graphql": ">=16"
  },
  "peerDependenciesMeta": {
    "graphql": { "optional": true }
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
